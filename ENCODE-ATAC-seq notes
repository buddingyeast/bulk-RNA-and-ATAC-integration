#login to compute node 
srun --nodes=1 --ntasks=1 --partition=cpu_medium --mem=64G --time=12:00:00 --pty bas

#load caper
module load condaenvs/new/caper

#load correct java version
module load jdk/17u028

#run job via caper (cromwell wrapper)
caper hpc submit /gpfs/scratch/finer03/atac-seq-pipeline/atac.wdl -i /gpfs/scratch/finer03/atac-seq-pipeline/example_input_json/template.json --singularity --leader-job-name encode_qc_testrun --backend slurm


#couldn't get the above to run for custom genome, ran manual pipeline instead for initial qc, #note that it works for Hg38 preset
#there were no adapters in the files, so ran bowtie to align
srun --time=6:00:00 bowtie2 --local --very-sensitive --no-mixed --no-discordant -X 700 -x ../output/bowtie2_index/mm39 -1 Hom-hRET_E1_S19_L005_R1_001.fastq.gz -2 Hom-hRET_E1_S19_L005_R2_001.fastq.gz | samtools view -bS - > RepE1.bam &

#samtools sort and index
srun --time=2:00:00 --mem=32G samtools sort RepE1.bam -o RepE1_sorted.bam & 

srun --time=2:00:00 --mem=32G samtools index RepE1_sorted.bam & 

#get mito %
srun --time=2:00:00 --mem=32G samtools idxstats RepE1_sorted.bam > RepE1_sorted.idxstats

#use number of second column to get number of mapped reads to charm
grep "chrM" RepE1_sorted.idxstats

srun --time=2:00:00 --mem=32G samtools flagstat RepE1_sorted.bam > RepE1_sorted.flagstat &

#use this to get total number of mapped reads and calculate % mapped to mito with number from column 2

head RepE1_sorted.flagstat 

#3.17% for RepE, 4.35% for RepF

#remove Mito reads
srun --time=2:00:00 --mem=32G samtools view -h RepE1_sorted.bam | grep -v chrM | samtools sort -O bam -o RepE1.rmChrM.bam -T .

#mark duplicates, will require Picard tools jar, can't get hpc module to work
srun --time=2:00:00 --mem=32G java -jar ./picard.jar MarkDuplicates QUIET=true INPUT=RepE1.header.bam OUTPUT=RepE1.marked.bam METRICS_FILE=RepE1.dup.metrics REMOVE_DUPLICATES=false CREATE_INDEX=true VALIDATION_STRINGENCY=LENIENT TMP_DIR=.

#may need to re-add headers
srun --time=2:00:00 --mem=32G java -jar ./picard.jar AddOrReplaceReadGroups I=RepE1.rmChrM.bam O=RepE1.header.bam RGID=2 RGLB=Atac RGPL=ILLUMINA RGPU=1 RGSM=E1

# filter out reads that multi-map and duplicates
 srun --time=2:00:00 --mem=32G samtools view -h -b -f 2 -F 1548 -q 30 RepE1.marked.bam | samtools sort -o RepE1.filtered.bam 
