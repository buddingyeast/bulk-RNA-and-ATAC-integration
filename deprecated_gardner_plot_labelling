target_gene_id <- "ENSMUSG00000058145"
target_gene_tss <- significant_genes_gr[target_gene_id]

plot_chrom <- as.character(seqnames(target_gene_tss))
plot_center <- start(target_gene_tss)
plot_start <- plot_center - 150000
plot_end <- plot_center + 350000

# Create plotting parameters object
params <- pgParams(chrom = plot_chrom, 
                   chromstart = plot_start, 
                   chromend = plot_end, 
                   assembly = "mm10")

# Create a plot page
pageCreate(width = 7.5, height = 4, default.units = "inches",showGuides = FALSE)

# Plot chromosome ideogram/label at the top
plotGenomeLabel(params = params, x = 0.5, y = 2.5, length = 6.5, default.units = "inches")

# Plot gene TSS track 
# (Using plotRanges for simple points, adjust y-position as needed)
# Filter genes to only those in the current plot region
genes_in_region <- subsetByOverlaps(significant_genes_gr, GRanges(params$chrom, IRanges(params$chromstart, params$chromend)))

if (length(genes_in_region) > 0) {
  
  # Get the label text using the correct path (CRITICAL)
  # Ensure this path correctly extracts the desired gene IDs
  gene_labels <- tryCatch({
    genes_in_region@elementMetadata@listData[["ensembl_gene_id"]] 
  }, error = function(e) {
    warning("Could not extract gene labels using the specified path. Plotting without labels.")
    NULL # Set labels to NULL if extraction fails
  })
  
  # Plot ranges (TSSs have width 1, appearing as lines/ticks)
  plotRanges(
    data = genes_in_region,
    params = params,
    x = 0.5, y = 2.5, width = 6.5, height = 0.5, # Height for the whole track space
    default.units = "inches",
    fill = "blue",          # Color for the TSS marks
    linecolor = "blue",     # Ensure line color is set too
    label = if (!is.null(gene_labels)) gene_labels else NULL, 
    fontsize = 6,          # Adjust label size
    just = c("left", "bottom"))
  }

