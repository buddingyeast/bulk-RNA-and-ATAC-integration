# Plot the significant interactions (pairs) as arcs
# First, filter the significant pairs to only those within the plotted region
pairs_in_region_df <- significant_results_df %>%
  filter(gene_id %in% names(genes_in_region) & peak_id %in% names(peaks_in_region))

if (nrow(pairs_in_region_df) > 0) {
  # Get the GRanges for the paired ends ONLY FOR THIS REGION
  genes1 <- genes_in_region[pairs_in_region_df$gene_id]
  peaks2 <- peaks_in_region[pairs_in_region_df$peak_id]}
  
if (length(genes1) > 0 && length(peaks2) > 0 && length(genes1) == length(peaks2)) {
  # Create the dataframe
  bedpe_df <- data.frame(
    chrom1 = as.character(seqnames(genes1)),
    start1 = start(genes1),
    end1 = end(genes1), # For TSS (width=1), start1 and end1 are often the same or off by 1
    chrom2 = as.character(seqnames(peaks2)),
    start2 = start(peaks2),
    end2 = end(peaks2),
    stringsAsFactors = FALSE
  )
  
  scores <- -log10(significant_results_df$padj)
  pal_fun <- colorRampPalette(brewer.pal(9, "Reds")[4:9])
  arch_colors <- mapColors(scores, palette = pal_fun)
  
  # --- Plot the significant interactions using plotPairs with the BEDPE dataframe ---
  archplot<-plotPairsArches(
    data = bedpe_df,
    params = params,       
    x = 0.5, 
    y = 1.5,              
    width = 6.5,          
    height = 1.0, 
    default.units = "inches",
    just = c("left", "top"),
    fill = NA,        
    linecolor = arch_colors,    
    lwd = 1,spaceHeight = 0.7)
  
  min_score <- min(scores, na.rm = TRUE)
  max_score <- max(scores, na.rm = TRUE)
  
  annoHeatmapLegend(plot=archplot,
    x = 6.0, y = 1.0, 
    width = unit(0.1, "inches"), 
    height = unit(0.75, "inches"),
    just = c("left", "bottom"),
    default.units = "inches",
    range = c(min_score, max_score), 
    palette = pal_fun,         
    fontsize = 6,
    # Add rounded labels for the min and max
    labels = c(round(min_score, 1), round(max_score, 1)),
    labeljust = c("left", "center"))
  
  # Add a label for the track area (optional)
  plotText(label = "Significant Interactions", x = 0.5, y = 1.5, just = c("left", "top"), default.units = "inches",col=arch_colors)
}

