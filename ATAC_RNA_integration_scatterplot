############################################################
# 2. Function to plot ONE strong/robust peak-gene
#    correlation
############################################################
plot_correlation_scatter <- function(target_gene_id, 
                                     target_peak_id, 
                                     rna_matrix, 
                                     atac_matrix, 
                                     results_summary) {
  
  # Check that gene exists in RNA matrix
  if (!(target_gene_id %in% rownames(rna_matrix))) {
    stop("Gene not found in RNA matrix: ", target_gene_id)
  }
  # Check that peak exists in ATAC matrix
  if (!(target_peak_id %in% rownames(atac_matrix))) {
    stop("Peak not found in ATAC matrix: ", target_peak_id)
  }
  
  # Extract RNA and ATAC values
  gene_vec <- as.numeric(
    rna_matrix[target_gene_id, ])
  
  peak_vec <- as.numeric(
    atac_matrix[target_peak_id, ])
  
  # Make sure vectors contain the same number of samples
  if (length(gene_vec) != length(peak_vec)) {
    stop(
      "RNA and ATAC matrices contain different numbers of samples.")
  }
  
  
  # Create dataframe for plotting
  plot_data <- data.frame(
    RNA_Counts = gene_vec,
    ATAC_Counts = peak_vec)
  
  # Pull statistics for this exact peak-gene pair
  stats <- results_summary %>%
    filter(
      gene_id == target_gene_id,
      peak_id == target_peak_id
    ) %>%
    slice(1)
  
  ##########################################################
  # Correlation label
  ##########################################################
  
  if (nrow(stats) == 1 && !is.na(stats$correlation)) {
    r_val_text <- paste0(
      "R = ",
      round(stats$correlation, 3))
    
  } else { 
    r_val_text <- "R = NA"  
  }
  
  
  ##########################################################
  # Adjusted p-value label, if padj is present
  ##########################################################
  
  if (
    "padj" %in% colnames(stats) &&
    nrow(stats) == 1 &&
    !is.na(stats$padj)
  ) {
    
    p_val_text <- paste0(
      "adj. p = ",
      format.pval(
        stats$padj,
        digits = 2,
        eps = 0.001
      ))
    
    plot_label <- paste(
      r_val_text,
      p_val_text,
      sep = "\n")
    
  } else {   
    plot_label <- r_val_text   
  }
  
  
  ##########################################################
  # Make scatterplot
  ##########################################################
  
  p <- ggplot(
    plot_data,
    aes(
      x = RNA_Counts,
      y = ATAC_Counts
    )) +
    
    # Individual RNA/ATAC observations
    geom_point(
      size = 2.5,
      alpha = 0.8) +
    
    # Linear regression line
    geom_smooth(
      method = "lm",
      se = FALSE,
      color = "blue",
      formula = y ~ x) +
    
    # Add R and adjusted p-value
    annotate(
      geom = "text",
      x = -Inf,
      y = Inf,
      label = plot_label,
      hjust = -0.1,
      vjust = 1.1,
      size = 3) +
    
    # Labels
    labs(
      title = paste0(
        target_gene_id,
        "\n",
        target_peak_id
      ),
      x = "RNA Norm. Counts",
      y = "ATAC Norm. Counts"
    ) +
    theme_bw() +
    theme(
      axis.title.x = element_text(size = 8),
      
      axis.title.y = element_text(size = 8),
      
      axis.text.x = element_text(size = 7),
      
      axis.text.y = element_text(size = 7),
      plot.title = element_text(
        size = 8,
        face = "bold",
        hjust = 0.5
      ),
      panel.grid.minor = element_blank())
  return(p)
}


############################################################
# 3. Function to plot MULTIPLE strong/robust
#    peak-gene correlations
############################################################
plot_strong_robust_candidates <- function(strong_robust_candidates,
                                          rna_matrix,
                                          atac_matrix,
                                          target_gene_list = NULL,
                                          ncol = 4) {
  
  # Start with provided peak-gene dataframe
  pairs_to_plot <- strong_robust_candidates
  
  # Optionally restrict plotting to selected genes
  if (!is.null(target_gene_list)) {
    pairs_to_plot <- pairs_to_plot %>%
      filter(
        gene_id %in% target_gene_list)
  }
  
  
  # Remove accidental duplicate peak-gene pairs
  pairs_to_plot <- pairs_to_plot %>%
    distinct(
      gene_id,
      peak_id,
      .keep_all = TRUE)
  
  
  # Stop if there are no pairs
  if (nrow(pairs_to_plot) == 0) {
    message(
      "No strong/robust peak-gene pairs found.")
    return(
      invisible(NULL))
  } 
  
  # Report number of plots
  message(
    "Plotting ",
    nrow(pairs_to_plot),
    " strong/robust peak-gene pairs across ",
    length(unique(pairs_to_plot$gene_id)),
    " genes.")
  
  
  # Empty list for individual plots
  plot_list <- list()
  
  
  ##########################################################
  # Loop through every peak-gene pair
  ##########################################################
  
  for (i in seq_len(nrow(pairs_to_plot))) {
    current_gene <- as.character(
      pairs_to_plot$gene_id[i])
    
    current_peak <- as.character(
      pairs_to_plot$peak_id[i])
    
    # Generate scatterplot
    p <- plot_correlation_scatter(
      
      target_gene_id = current_gene,  
      target_peak_id = current_peak,    
      rna_matrix = rna_matrix,      
      atac_matrix = atac_matrix,
      results_summary = strong_robust_candidates)
    
    # Unique plot name
    plot_name <- paste(
      current_gene,
      current_peak,
      sep = "_vs_")   
    
    # Store plot
    plot_list[[plot_name]] <- p
  }
  
  
  ##########################################################
  # Combine plots into grid
  ##########################################################
  
  combined_grid <- patchwork::wrap_plots(
    plot_list,
    ncol = ncol)
  return(combined_grid)
}

