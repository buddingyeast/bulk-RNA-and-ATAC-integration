###csaw analysis###
library(rtracklayer)
library(csaw)
library(GenomicRanges)
library(SummarizedExperiment)
library(S4Vectors)

"~/Desktop/Rebecca paper/degcre/ATAC_normalized_counts_matrix.csv"#counts matrix
counts_matrix <- read.csv("~/Desktop/ATAC_normalized_counts_matrix.csv", header = TRUE)


#peakinfo, granges
peak_ranges<-makeGRangesFromDataFrame(counts_matrix[,1:4],keep.extra.columns = TRUE)

#summarized object
se_object <- SummarizedExperiment(assays = list(counts = as.matrix(counts_matrix[,5:16])), rowRanges = peak_ranges) 
se_object$totals <- c(92852562, 116990304, 143967900, 135791068, 90125588, 146721358, 120516074, 107355642, 102799738, 134543446, 85994858, 141253244)
counts_matrix <- assays(se_object)$counts

se_object <- normOffsets(se_object)

sample_metadata <- data.frame(time = c("E12.5", "E12.5","E14.5","E14.5","P0","P0","P07","P07","P21","P21","Adult","Adult"),row.names = c("E125_1","E125_2","E145_1","E145_2","ACP0_1","ACP0_2","ACP07_1","ACP07_2","ACP21_1","ACP21_2","A649_1","A653_2"))

#time as numeric
sample_metadata <- data.frame(time = c("12", "12", "14", "14","21", "21", "28","28","42", "42","90","90"),row.names = c("E12.5", "E12.5","E14.5","E14.5","P0","P0","P07","P07","P21","P21","Adult","Adult"),row.names = c("E125_1","E125_2","E145_1","E145_2","ACP0_1","ACP0_2","ACP07_1","ACP07_2","ACP21_1","ACP21_2","A649_1","A653_2"))

sample_metadata_df <- S4Vectors::DataFrame(sample_metadata)
colData(se_object) <- sample_metadata_df

#design regression matrix
design_matrix <- model.matrix(~as.numeric(time), data = colData(se_object))
print(design_matrix)

#statistical test
se_object_edge <- estimateDisp(se_object, design_matrix)
fit <- glmFit(se_object_edge, design_matrix)
lrt <- glmLRT(fit, coef = 2) # Adjust 'coef' based on your design matrix, i.e. 1=intercept B-zero

#to set null hypothesis above 0, possibly improves FDR for stronger peaks.
log_fold_change <- log2(1.2)
results_lrt <- glmTreat(fit, coef = 2, lfc = log_fold_change)

#save data
results <- topTags(lrt, n = Inf, sort.by = "PValue")
results_table<-results$table
write.csv(results_table, file = "~/Desktop/csaw_results.csv", row.names = TRUE)

#alt. to raw counts matrix, starting with Rebecca's filtered counts matrix that has chr start end
library(edgeR)
counts_matrix <- read.csv("~/Desktop/counts_cleaned.csv", header = TRUE)
CREobj<- makeGRangesFromDataFrame(counts_matrix, keep.extra.columns = TRUE,seqnames.field = "name", start.field = "start",end.field = "end")  
counts_matrix <- as.matrix(mcols(CREobj))
group <- factor(c("E12.5", "E12.5","E14.5", "E14.5","P0","P0", "P7","P7","P21", "P21","Adult","Adult"))
group<- as.numeric(c("12","12","14","14","21","21","28","28","42","42","90","90"))
y <- DGEList(counts = counts_matrix, group = group, genes = as.data.frame(CREobj))
y <- calcNormFactors(y)
design <- model.matrix(~group)
y <- estimateDisp(y, design)
fit <- glmQLFit(y, design, robust = TRUE)
qlf <- glmQLFTest(fit, coef=2)
topTags(qlf)
results_table <- topTags(qlf, n = Inf, sort.by = "PValue")$table
significant_regions <- results_table[results_table$PValue < 0.05, ]
write.csv(significant_regions,"~/Desktop/csawresults.csv", row.names = FALSE)

