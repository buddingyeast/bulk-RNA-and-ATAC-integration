library(TEKRABber)

#deseq2 output, edited colname of rows to "name"
deseq_data<-read.csv("~/Desktop/deg_rna_results.csv")


#get tss info, currently pulls mm10
my_ensmusg_ids<-deseq_data$name

#mm10, last release
ensembl_mm10 <- useEnsembl(biomart = "ensembl",dataset = "mmusculus_gene_ensembl",version = 102)
gene_info <- getBM(
  attributes = c("ensembl_gene_id", "chromosome_name", "start_position", "end_position", "strand"),
  filters = "ensembl_gene_id",
  values = my_ensmusg_ids,
  mart = ensembl_mm10)

#keep in mind that all TSS will be defined at 5' end on + strand
#because granges won't accept output below, ignore this code!!!
library(dplyr)
gene_info2 <- gene_info %>%
  mutate(
    gene_start_new = if_else(strand == -1, end_position, start_position),
    gene_end_new = if_else(strand == -1, start_position, end_position)
  ) %>%
  select(-start_position, -end_position) %>% # Optionally remove the original columns
  rename(start_position = gene_start_new, end_position = gene_end_new) 

#merge tss and deseq2 output
merged_data <- merge(gene_info,deseq_data, by.x = "ensembl_gene_id", by.y = "name")
merged_data$strand <- ifelse(merged_data$strand == 1, "+", "-")
merged_data$chromosome_name<- paste0("chr", merged_data$chromosome_name)

gr_object <- makeGRangesFromDataFrame(
  merged_data,
  keep.extra.columns = TRUE,
  seqnames.field = "chromosome_name",
  start.field = "start_position",
  end.field = "end_position",
  strand.field = "strand")

csaw_data<-read.csv("~/Desktop/csaw_results.csv")
gr_object2 <- makeGRangesFromDataFrame(
  csaw_data,
  keep.extra.columns = TRUE,
  seqnames.field = "seqnames",
  start.field = "start",
  end.field = "end",
  strand.field = "strand")


#filter csaw to remove peaks that aren't within N-1 bp of genes in the rnaseq
overlaps <- findOverlaps(gr_object2, gr_object, maxgap = 99999)
overlapping_indices <- unique(queryHits(overlaps))
filtered_Cre <- gr_object2[overlapping_indices]


#create DegCre Object with distance filter
myDegCreResList <- runDegCre(DegGR=gr_object,
                             DegP=gr_object$pvalue,
                             DegLfc=gr_object$log2FoldChange,
                             CreGR=filtered_Cre,
                             CreP=filtered_Cre$PValue,
                             CreLfc=filtered_Cre$logFC, 
                             reqEffectDirConcord=TRUE,
                             verbose=FALSE)

#without distance filter
myDegCreResList <- runDegCre(DegGR=gr_object,
                             DegP=gr_object$pvalue,
                             DegLfc=gr_object$log2FoldChange,
                             CreGR=gr_object2,
                             CreP=gr_object2$PValue,
                             CreLfc=gr_object2$logFC, 
                             reqEffectDirConcord=TRUE,
                             verbose=FALSE)

#filter results
passFDR <- which(mcols(myDegCreResList$degCreHits)$assocProbFDR <= 0.05)
passProb <- which(mcols(myDegCreResList$degCreHits)$assocProb >= 0.25)
keepDegCreHits <- myDegCreResList$degCreHits[intersect(passFDR,passProb)]

#find optimal alpha with filter
alphaOptList <- optimizeAlphaDegCre(DegGR=gr_object,
                                    DegP=gr_object$pvalue,
                                    DegLfc=gr_object$log2FoldChange,
                                    CreGR=filtered_Cre,
                                    CreP=filtered_Cre$PValue,
                                    CreLfc=filtered_Cre$logFC,
