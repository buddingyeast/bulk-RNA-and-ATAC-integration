#referene genome index
cp /gpfs/data/chaklab/home/chubah01/2025/ATACseq/gkmPipeline/mm10.fa.fai .

#generate chromosome sizes file

cut -f1,2 mm10.fa.fai > mm10.genome

#use bedtools with a bedfile (chr start stop) and reference file to extract DNA sequences

bedtools getfasta -fi mm10.fa -bed temporal_lmmsig.bed -fo temporal_peaks_positive.fa

#use shuffle to create a set of random negative peaks for background
#note that you may wish to use temporal vs constant instead etc...

bedtools shuffle -i temporal_lmmsig.bed -g mm10.genome -excl temporal_lmmsig.bed > temporallmmnegative.bed

#put this bed file through mm10 to generate fa file
bedtools getfasta -fi mm10.fa -bed temporallmmnegative.bed -fo temporal_peaks_negative.fa

