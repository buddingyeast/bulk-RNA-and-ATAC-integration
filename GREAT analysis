#great analysis
BiocManager::install(c( "rGREAT", "rtracklayer", "GenomicRanges", "TxDb.Mmusculus.UCSC.mm10.knownGene","org.Mm.eg.db" ))
library(rGREAT)
library(rtracklayer)
library(GenomicRanges)
library(TxDb.Mmusculus.UCSC.mm10.knownGene)
library(org.Mm.eg.db)

background_peaks <- import("D:/Rebecca_paper/90k_peaks.bed")
background_peaks <- import("D:/Rebecca_paper/allpeaks.bed")

for (i in 1:4) {
  # 1. Dynamically build the input file path
  input_file <- paste0("D:/Rebecca_paper/cluster_", i, ".bed")
  
  # 2. Import the bed file
  cluster_data <- import(input_file)
  
  # 3. Run the great analysis
  great_results <- great(
    gr = cluster_data,
    gene_sets = c("GO:BP"),
    tss_source = "TxDb.Mmusculus.UCSC.mm10.knownGene",
    background = background_peaks,
    extension = 100000  # Sets maximum cap to 100 kb (in base pairs)
  )
  
  # 4. Extract the enrichment table
  results_table <- getEnrichmentTable(great_results)
  
  # 5. Dynamically build the output file path and save
  output_file <- paste0("D:/Rebecca_paper/cluster", i, "_GREAT_GO_MF.csv")
  write.csv(results_table, output_file, row.names = FALSE)
}
